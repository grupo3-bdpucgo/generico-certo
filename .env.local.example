# Qdrant Cloud (cluster free): painel > Cluster > API Keys
QDRANT_URL=https://SEU-CLUSTER.cloud.qdrant.io:6333
QDRANT_API_KEY=coloque-a-chave-aqui
QDRANT_COLLECTION=medicamentos

# Alíquota de ICMS usada para escolher as colunas "PMC xx %" e "PF xx %".
# Goiás = 19. Valores aceitos: 0, 12, 17, 17.5, 18, 19, 19.5, 20, 20.5, 21, 22, 22.5, 23
ALIQUOTA_ICMS=19

# PostgreSQL no Neon (plano free): painel > Connection Details > "Pooled connection".
# Extensões usadas: unaccent e pg_trgm (o script 03-postgres.ts cria as duas).
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/generico_certo?sslmode=verify-full

# Modelo de embeddings (Transformers.js)
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
